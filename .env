# ============================================
# URBAN PALATE - Environment Variables
# ============================================

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development

# ---- WhatsApp Configuration ----
#  SWITCH to callmebot (free, no credit card needed)
WHATSAPP_PROVIDER=callmebot
# ---- CallMeBot Configuration ----
# Get your API key by sending "I allow callmebot to send me messages" 
# to +34 644 59 71 68 on WhatsApp
CALLMEBOT_API_KEY=your_callmebot_api_key_here
# ---- Restaurant Contact ----
# The restaurant's WhatsApp number (Kenyan number)
OWNER_WHATSAPP_NUMBER=+254728330852

# ---- Admin Security ----
# Used to view bookings at /api/bookings?key=YOUR_KEY
ADMIN_KEY=your_secure_admin_key_here

# ---- CORS Configuration ----
# Comma-separated list of allowed origins
# Leave empty for all origins (development only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database Configuration ----
# Currently using file-based storage
# For future MongoDB migration:
DB_TYPE=file
# MONGODB_URI=mongodb://localhost:27017/urban-palate